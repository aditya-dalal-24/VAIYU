# Copy to backend/.env for local development. BackendApplication loads it
# before Spring starts; real environment variables always take precedence.

SERVER_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/vaiyu
DB_USERNAME=postgres
DB_PASSWORD=change-me

AI_SERVICE_URL=http://localhost:8000
# Where the AI service can fetch uploaded satellite frames from.
PUBLIC_BASE_URL=http://localhost:8081

# Required to run archive ingestion. At least 24 characters; generate one with
#   openssl rand -hex 32
VAIYU_ADMIN_TOKEN=

# Browser origins allowed to call the API, comma-separated.
VAIYU_CORS_ALLOWED_ORIGINS=http://localhost:5173
