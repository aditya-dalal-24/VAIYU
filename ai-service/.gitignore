# Trained weights are build artifacts, not source. They are produced by the
# training pipelines and copied between machines by hand; committing them would
# put tens of megabytes of binary into every clone and make the repository the
# wrong kind of model registry.
checkpoints/*
!checkpoints/.gitkeep

# Datasets and anything derived from them. Regenerated by the preparation
# scripts from whatever archive is supplied.
data/*
!data/.gitkeep

# Local environment and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
