# Copy to .env in the repository root on the server (next to docker-compose.yml).
# Never commit the real file.

# The domain the app is served on. Its DNS A record must point at this server
# before first start, or Caddy cannot obtain a certificate.
VAIYU_DOMAIN=cyclones.example.com

# Generate each with:  openssl rand -hex 32
VAIYU_DB_PASSWORD=
VAIYU_ADMIN_TOKEN=
